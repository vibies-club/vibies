{
  "name": "vibies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/demo.test.ts tests/demo-errors.test.ts tests/access-core.test.ts tests/project-core.test.ts tests/project-github.test.ts tests/staging.test.mjs tests/wiki.test.ts tests/read-only.test.ts tests/preview-cloudflare.test.mjs",
    "cf:typegen": "wrangler types",
    "test:d1": "node --test tests/d1-access-workerd.test.ts tests/d1-access.test.ts tests/d1-projects-workerd.test.ts tests/d1-projects.test.ts tests/d1-schema.test.mjs tests/google-auth.test.ts tests/d1-instructor-workerd.test.ts",
    "build:cloudflare:production": "CLOUDFLARE_ENV=production npm run build:cloudflare",
    "build:cloudflare": "vite build --config vite.cloudflare.config.ts && node scripts/prerender-static.mjs",
    "dev:cloudflare": "vite dev --config vite.cloudflare.config.ts --port 3001",
    "test:worker": "node --test worker/boundary.test.mjs tests/google-coordinator.test.mjs"
  },
  "dependencies": {
    "@better-auth/core": "1.7.9",
    "@better-auth/kysely-adapter": "1.7.9",
    "better-auth": "1.7.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "wrangler": "4.151.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.0"
    }
  }
}
